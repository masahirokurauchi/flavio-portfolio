<%= render 'shared/work_header' %>

<div class="logo-images">
    <%= link_to image_tag("ele.png", class: "image", id: "ele"), work_logo_path %>
    <%= link_to image_tag("rainb.png", class: "image", id: "rainb"), work_logo_path %>
    <%= link_to image_tag("green.png", class: "image", id: "green"), work_logo_path %>
</div>











<script type="module">
$(document).ready(function() {
    $('header').css('background-color', 'white');
    $('.works a, .aboutme a, .home a, .branding a, .logo a, .three_d a').css('color','black');
});

$(function() {
	var headerHeight = $('header').outerHeight(),
		startPos = 0;
	$(window).on('load scroll', function() {
		var scrollPos = $(this).scrollTop();
		if ( scrollPos > startPos && scrollPos > headerHeight ) {
			$('header').css('top', '-' + headerHeight + 'px');
		} else {
			$('header').css('top', '0');
		}
		startPos = scrollPos;
	});
});	

</script>